{
  "name": "@apollo-ops/dsh-client-ui-apollo-ops",
  "description": "Portable Apollo Ops Expert plugin for DSH Web",
  "version": "1.0.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.3-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.3-alpha.1 <0.3.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.1",
    "@deepseek-ai/cordis": "~4.0.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.3-alpha.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
